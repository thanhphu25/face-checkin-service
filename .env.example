# Sao chép file này thành .env rồi điền giá trị thật cho máy của bạn.
# KHÔNG commit file .env.

# --- Database ---
# Dev nhanh bằng SQLite:
DATABASE_URL=sqlite:///./facecheckin.db
# App/seed chạy trên máy có thể kết nối PostgreSQL của Compose qua localhost:
# DATABASE_URL=postgresql+psycopg://app:<POSTGRES_PASSWORD>@localhost:5432/facecheckin
# Trong container, Compose tự tạo DATABASE_URL với hostname postgres từ các biến dưới.
# Nếu đổi user, tên DB hoặc cổng publish, sửa URL trên máy tương ứng.
POSTGRES_DB=facecheckin
POSTGRES_USER=app
POSTGRES_PASSWORD=doi-mat-khau-postgres-nay
POSTGRES_PORT=5432

# --- Docker Compose ---
APP_PORT=8000
# Có thể đổi tag khi build/CI; mặc định Compose dùng face-checkin-service:local.
APP_IMAGE=face-checkin-service:local

# --- Auth ---
# BẮT BUỘC, không có giá trị mặc định — app sẽ không khởi động nếu thiếu.
# Sinh chuỗi ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=doi-gia-tri-nay-truoc-khi-chay
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Seed dữ liệu mẫu (chỉ dùng khi chạy scripts/seed.py) ---
# Không có giá trị mặc định và không được commit giá trị thật.
# Script đọc trực tiếp biến môi trường: export/truyền hai biến vào tiến trình seed.
# Chỉ điền hai dòng dưới trong .env sẽ không tự đưa chúng vào môi trường của script.
# Tối thiểu 12 ký tự; sinh chuỗi: python -c "import secrets; print(secrets.token_urlsafe(24))"
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=

# --- Face matching ---
# Ngưỡng cosine mặc định, chưa được hiệu chỉnh trên tập ảnh đại diện.
# Xem docs/architecture.md#embedding và docs/phase-2-improvements.md (V09).
SIMILARITY_THRESHOLD=0.40
EMBEDDING_MODEL=buffalo_s

# --- API ---
MAX_UPLOAD_MB=5
